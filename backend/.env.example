# =============================================================
# DleafTech Enterprise CRM - Production Environment Configuration
# =============================================================
PORT=5000
NODE_ENV=production

# -------------------------------------------------------------
# Database (PostgreSQL Cloud e.g., Supabase / Neon / AWS RDS)
# -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:aman@localhost:5432/whatsapp"

# -------------------------------------------------------------
# Security & JWT Authentication
# -------------------------------------------------------------
JWT_SECRET="dleaftech-crm-secure-enterprise-jwt-token-key-2026-production"
CLIENT_URL="http://localhost:3000"

# -------------------------------------------------------------
# Transactional Email (SMTP - Zoho / SendGrid / Brevo / AWS SES)
# -------------------------------------------------------------
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS="SG.your_actual_sendgrid_key_here"
SMTP_FROM="DleafTech CRM <support@dleaftech.com>"

# -------------------------------------------------------------
# Meta WhatsApp Cloud API (Production Messaging Engine)
# -------------------------------------------------------------
WHATSAPP_API_TOKEN="your_meta_system_user_permanent_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
